{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/purchase",
      "dest": "/public/purchase.html"
    },
    {
      "src": "/buy",
      "dest": "/public/purchase.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
